{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "jekyll",
  "installCommand": "bundle install",
  "buildCommand": "bundle exec jekyll build",
  "outputDirectory": "_site",
  "redirects": [
    {
      "source": "/directorio.html",
      "destination": "/equipo.html",
      "permanent": true
    }
  ]
}
